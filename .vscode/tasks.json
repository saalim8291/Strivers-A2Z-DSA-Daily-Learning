// Guide: https://takeuforward.org/set-up/how-to-set-up-visual-studio-code-for-c-cp-and-dsa

// For MAC
{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "/opt/homebrew/bin/g++-16",
      "args": ["-std=c++17", "-o", "${fileBasenameNoExtension}", "${file}"],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "compile and run",
      "type": "shell",
      "command": "/opt/homebrew/bin/g++-16 -std=c++17 -isysroot $(xcrun --show-sdk-path) -o ${fileBasenameNoExtension} ${file} && ./${fileBasenameNoExtension} < input.txt > output.txt",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}

